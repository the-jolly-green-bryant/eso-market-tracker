{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "market-tracker-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-08",
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
  "vars": {
    "DISCORD_APPLICATION_ID": "1121195192066781305",
    "DISCORD_PUBLIC_KEY": "928ea6e2a1141717429317cb2f655f4543ec2ac4d027429cea1240d40de2de62",
  },
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [
    {
      "binding": "ESO_MARKET_TRACKER",
      "id": "c1b66d8fb78d4881ab064e462bd5d5f6",
      "remote": true,
    },
  ],
  "routes": [
    {
      "pattern": "data.esomarkettracker.com",
      "custom_domain": true,
    },
  ],
  /**
