{
  "name": "@eso-market-tracker/api",
  "version": "0.0.1",
  "description": "The official open API for querying pricing data.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "ISC",
  "type": "module",
  "private": true,
  "scripts": {
