{
  "name": "eso-market-tracker",
  "version": "2026.07.30+619d168937d",
  "description": "A source-available pricing database for Elder Scrolls Online and the spiritual successor to ESO Market Tracker.",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "pnpm run inject-version && pnpm run test && pnpm -r build",
    "clean": "pnpm -r clean",
    "test": "pnpm vitest run",
    "coverage": "pnpm vitest run --coverage",
    "inject-version": "node scripts/inject-version.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier . --write",
    "check": "pnpm lint && pnpm typecheck",
    "prepare": "husky"
  },
  "keywords": [
    "elder-scrolls-online",
    "eso",
    "market-data",
    "price-tracker"
  ],
  "author": "Bryant James",
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/the-jolly-green-bryant/eso-market-tracker.git"
  },
  "bugs": {
    "url": "https://github.com/the-jolly-green-bryant/eso-market-tracker/issues"
  },
  "homepage": "https://esomarkettracker.com",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eso-market-tracker/logging": "workspace:*",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "^10.8.0",
    "eslint-plugin-jsdoc": "^63.3.2",
    "eslint-plugin-sonarjs": "^4.2.0",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
